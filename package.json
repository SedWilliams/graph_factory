{
  "name": "graph-factory",
  "version": "1.0.0",
  "description": "Edit a graph, get an agentic AI coding system your harness can actually run",
  "keywords": [
    "agents",
    "ai",
    "claude-code",
    "codex",
    "opencode",
    "agent-orchestration",
    "workflow",
    "graph",
    "cli"
  ],
  "license": "MIT",
  "author": "SedWilliams",
  "homepage": "https://github.com/SedWilliams/graph_factory#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SedWilliams/graph_factory.git"
  },
  "bugs": {
    "url": "https://github.com/SedWilliams/graph_factory/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "graph-factory": "bin/graph-factory.mjs"
  },
  "files": [
    "bin",
    "src",
    "public",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/launcher.mjs",
    "start:server": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "check": "node --check bin/graph-factory.mjs && node --check src/launcher.mjs && node --check src/server.mjs && node --check public/app.js",
    "test": "node --test \"test/*.test.mjs\"",
    "format": "prettier --write \"src/**/*.mjs\" \"bin/**/*.mjs\" \"test/**/*.mjs\" \"tools/**/*.{mjs,html}\" \"public/**/*.{js,css,html}\" \"*.json\"",
    "lint": "prettier --check \"src/**/*.mjs\" \"bin/**/*.mjs\" \"test/**/*.mjs\" \"tools/**/*.{mjs,html}\" \"public/**/*.{js,css,html}\" \"*.json\""
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
